rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{userId} — perfil del usuario, doc ID == uid del usuario
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // favorites/{favoriteId} — favoritas sincronizadas, filtradas por campo userId
    match /favorites/{favoriteId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // sharedCollections/{collectionId} — colecciones públicas o privadas por dueño
    match /sharedCollections/{collectionId} {
      allow read: if resource.data.isPublic == true
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Todo lo demás: denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
